{
  "name": "evron",
  "version": "0.2.0",
  "private": false,
  "description": "EVRON — passive recon terminal for Linux",
  "type": "module",
  "bin": {
    "evron": "./bin/evron.js"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "dev": "tsx src/cli.tsx",
    "evron": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "pack:deb": "bash scripts/build-deb.sh",
    "pack:ppa": "bash scripts/build-ppa.sh",
    "upload:ppa": "bash scripts/upload-ppa.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
