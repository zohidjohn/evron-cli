# ── Operator logins (up to as many as you want) ─────────────────────────────
# Format: user:password,user2:password2,...
EVRON_OPERATORS=alice:change-me-1,bob:change-me-2,carol:change-me-3,dave:change-me-4,erin:change-me-5

# Legacy single shared password (optional if EVRON_OPERATORS is set)
# EVRON_ACCESS_PASSWORD=

# ── Optional enrichment APIs (bundled in this env for your demo installs) ───
# NVD (CVE) — free key raises rate limits
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# VirusTotal — free community key
# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB — free tier
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Google Safe Browsing — free API key via Google Cloud
# https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=

# Have I Been Pwned — paid API key for email breach lookup
# https://haveibeenpwned.com/API/Key
# (Password checks use free k-anonymity and need no key.)
HIBP_API_KEY=

# Shodan — account API key (free tier available)
# https://account.shodan.io/
SHODAN_API_KEY=

# Censys Platform — create a Personal Access Token (PAT), not legacy API ID/Secret
# https://platform.censys.io → user icon → API Access → Create New Token
# Docs: https://docs.censys.com/reference/get-started
CENSYS_PAT=
# Optional (paid/org plans only; Free accounts leave blank)
CENSYS_ORG_ID=
